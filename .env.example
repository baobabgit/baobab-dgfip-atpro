# Copiez ce fichier en `.env` et renseignez vos valeurs.
# `.env` est gitignoré : n'y mettez jamais de secret dans le dépôt.
# Chargé/validé via pydantic-settings (DatabaseSettings).

APP_ENV=development
LOG_LEVEL=INFO

# Dossier local hors depot pour CSV reels de reference (optionnel)
# Voir docs/reference-data.md — ne jamais committer ces fichiers.
# ATPRO_REFERENCE_CSV_DIR=D:/chemin/vers/csv-reels

# --- PostgreSQL (v0.2.0) ----------------------------------------------------
# Option A : URL complete SQLAlchemy
# ATPRO_DATABASE_URL=postgresql+psycopg://atpro:atpro@localhost:5432/atpro

# Option B : composants separes (utilises si ATPRO_DATABASE_URL est absente)
ATPRO_DATABASE_HOST=localhost
ATPRO_DATABASE_PORT=5432
ATPRO_DATABASE_NAME=atpro
ATPRO_DATABASE_USER=atpro
ATPRO_DATABASE_PASSWORD=atpro
# ATPRO_DATABASE_DRIVER=postgresql+psycopg
